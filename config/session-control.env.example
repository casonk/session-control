# session-control local runtime settings.
# Copy to config/session-control.env.local and keep the .local file untracked.

SESSION_CONTROL_HOST=127.0.0.1
SESSION_CONTROL_PORT=5420

# Keep the app on loopback by default. Prefer Caddy/mTLS or WireGuard for phone access.
# SESSION_CONTROL_ALLOW_REMOTE=0
# SESSION_CONTROL_PUBLIC_ORIGIN=https://session-control.example.local
# SESSION_CONTROL_ALLOWED_ORIGINS=https://session-control.example.local

# Provider roots. Defaults are shown for clarity.
# SESSION_CONTROL_CODEX_ROOT=~/.codex
# SESSION_CONTROL_CLAUDE_ROOT=~/.claude
# SESSION_CONTROL_CONTINUE_ROOT=~/.continue
# SESSION_CONTROL_COPILOT_ROOT=~/.copilot
# SESSION_CONTROL_GROK_ROOT=~/.grok
# SESSION_CONTROL_AGY_ROOT=~/.gemini/antigravity-cli
# claude.ai chats via the Compliance API (Claude Enterprise): `session-control sync-web`
# SESSION_CONTROL_ANTHROPIC_COMPLIANCE_KEY_FILE=~/.config/session-control/anthropic-compliance.key
# SESSION_CONTROL_ANTHROPIC_USER_EMAIL=
# SESSION_CONTROL_WEBCHAT_DIR=~/.local/share/session-control/webchats

# Optional Codex resume fallback. Leave unset to use the model recorded in each
# Codex session. Set this when your global Codex default is not supported by the
# auth mode used on this machine.
# SESSION_CONTROL_CODEX_RESUME_MODEL=gpt-5.4
#
# Optional Codex permission preset for web-launched resumes:
# default (use Codex config), recorded, read-only, auto, or full-auto.
# SESSION_CONTROL_CODEX_PERMISSION_PRESET=default

# Optional Claude status polling. The default command reports auth/subscription
# status only on current Claude Code releases; it does not expose plan limit
# windows or reset percentages. If Claude adds limit fields to the JSON output,
# session-control will display sanitized copies of those fields.
# SESSION_CONTROL_CLAUDE_STATUS_POLL=0
# SESSION_CONTROL_CLAUDE_STATUS_COMMAND=claude auth status --json
# Use an absolute path if systemd's service PATH cannot find `claude`.
# SESSION_CONTROL_CLAUDE_STATUS_COMMAND=/home/user/.local/bin/claude auth status --json
# SESSION_CONTROL_CLAUDE_STATUS_POLL_INTERVAL=300
# SESSION_CONTROL_CLAUDE_STATUS_TIMEOUT=10

# Delete destination.
# SESSION_CONTROL_TRASH_DIR=~/.local/share/session-control/trash
# SESSION_CONTROL_DIGEST_DIR=~/.local/share/session-control/digests
# SESSION_CONTROL_TRASH_RETENTION_DAYS=7
# SESSION_CONTROL_DIGEST_RETENTION_DAYS=365

# Scheduled pruning threshold. Supports h, d, or w suffixes.
# SESSION_CONTROL_PRUNE_OLDER_THAN=180d
# Optional relative retention for short subagents in the same scheduled run.
# Choose one: 25% and 4x both turn a 180d baseline into 45d.
# SESSION_CONTROL_PRUNE_SHORT_SUBAGENT_PERCENT=25%
# SESSION_CONTROL_PRUNE_SHORT_SUBAGENT_MULTIPLIER=4x

# Set a stable secret for persistent browser sessions when running as a service.
# SESSION_CONTROL_SECRET_KEY=change-me-to-a-local-random-value

# Web terminal integration. Set the URL of your ttyd/webterm instance to enable
# the Open button. SESSION_CONTROL_TMUX_SESSION is the base tmux session name
# that the webterm is attached to (default: pit-box).
# SESSION_CONTROL_WEBTERM_URL=https://webterm.example.local
# SESSION_CONTROL_TMUX_SESSION=main

# Optional mTLS credentials for the connection monitor's WebTerm probe only.
# The client certificate must be trusted by the proxy. The CA file is added to
# system trust for verifying the WebTerm server certificate. Keep the private
# key outside the repo and readable only by the session-control service user.
# Set both client cert and key together; they are never sent to other targets.
# SESSION_CONTROL_MONITOR_WEBTERM_CLIENT_CERT=~/.config/session-control/webterm-monitor.crt
# SESSION_CONTROL_MONITOR_WEBTERM_CLIENT_KEY=~/.config/session-control/webterm-monitor.key
# SESSION_CONTROL_MONITOR_WEBTERM_CA_CERT=~/.config/session-control/webterm-server-ca.crt

# Scan result TTL cache. Each unique (providers) combination is cached for this
# many seconds so rapid browser reloads or proxy retries cannot trigger repeated
# filesystem scans. Set to 0 to disable caching.
# SESSION_CONTROL_SCAN_CACHE_TTL=5

# Connection monitor. Comma-separated list of name=address pairs to probe.
# Address formats:
#   ICMP ping:    desktop=192.168.10.5
#   TCP port:     desktop-ssh=192.168.10.5:22
#   HTTP check:   webterm=https://webterm.example.local
# The webterm URL (SESSION_CONTROL_WEBTERM_URL) is always added automatically.
# SESSION_CONTROL_MONITOR_TARGETS=wg-gateway=10.99.0.1,desktop=192.168.10.5,dns=8.8.8.8,dns-cf=1.1.1.1
# SESSION_CONTROL_MONITOR_INTERVAL=5

# Optional metadata-only federation. Each node has a stable, non-secret id and
# label. `inventory` and `publish-inventory` never export session transcripts,
# prompt previews, absolute paths, delete targets, or resume commands.
# SESSION_CONTROL_FEDERATION_NODE_ID=air
# SESSION_CONTROL_FEDERATION_NODE_LABEL=MacBook Air
#
# Enable only on the central aggregator. The directory is created mode 0700 and
# accepted snapshots mode 0600. Tokens map each approved node id to a distinct
# secret; keep this line in the ignored local environment file.
# SESSION_CONTROL_FEDERATION_STORE_DIR=~/.local/share/session-control/federation
# SESSION_CONTROL_FEDERATION_TOKENS=air=replace-with-a-random-token

# Shared agent memory: condensed notes written before a session is removed.
# SESSION_CONTROL_MEMORY_DIR=~/.local/share/session-control/memory
# SESSION_CONTROL_CONDENSE_ON_REMOVE=1
# "extractive" (default, offline) or "ollama" (loopback Ollama / crew-chief only).
# SESSION_CONTROL_CONDENSER=extractive
# SESSION_CONTROL_CONDENSER_URL=http://127.0.0.1:11434
# SESSION_CONTROL_CONDENSER_MODEL=qwen3:14b
# Retention for shared-memory notes (`session-control memory retention`, run by the daily
# condense timer). Notes and rollups expire this many days after the last activity of the
# session they describe; archived originals (merged into a rollup) this many days after
# they were archived. 0 keeps them forever.
# SESSION_CONTROL_MEMORY_RETENTION_DAYS=180
# SESSION_CONTROL_MEMORY_ARCHIVE_RETENTION_DAYS=30

# Log verbosity on stderr (journal under systemd): debug, info, warning, error. Default info.
# SESSION_CONTROL_LOG_LEVEL=info
# Also write a rotating log file (5 MB x 3, owner-only): a path, "default" (platform
# location) or "off". Unset = on for macOS/Windows (no journal), off on Linux (journal).
# SESSION_CONTROL_LOG_FILE=default
